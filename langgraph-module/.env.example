# Copy this file to .env and fill in your own values.

# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# WIKI_HARNESS_MODEL=claude-sonnet-5
# WIKI_HARNESS_MCP_URL=https://next.obudget.org/mcp
# WIKI_HARNESS_MAX_STEPS=12

# Saved-query cache for Phase 2/3 research.
# Existing matching specs are used first. On a cache miss, the normal ReAct
# phase runs once and saves its successful DatasetDBQuery calls for the next run.
# WIKI_HARNESS_QUERY_RESEARCH_CACHE=true
# WIKI_HARNESS_QUERY_OPTIMIZER_DIR=../query_optimizer
# WIKI_HARNESS_QUERY_CACHE_DIR=../query_optimizer/queries
